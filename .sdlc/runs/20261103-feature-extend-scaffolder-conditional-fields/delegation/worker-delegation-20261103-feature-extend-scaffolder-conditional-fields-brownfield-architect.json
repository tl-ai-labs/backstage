          "section_json": "[\n  {\n    \"id\": \"U01\",\n    \"path\": \"plugins/scaffolder-react/src/next/lib/schema.ts\",\n    \"action\": \"edit\",\n    \"phase\": \"codegen\",\n    \"behaviour\": \"Resolve cross-step JSON Schema dependencies and if/then/else conditions against formData and identify cross-step hidden property keys\",\n    \"rules\": [\n      \"1. Preserve existing isObject, extractUiSchema, extractSchemaFromStep, and createFieldValidation implementations without changing their signatures or behavior.\",\n      \"2. Add internal helper stripUndefined(data: JsonObject): JsonObject that returns a copy of data omitting keys whose value is undefined (recursing into nested JsonObjects).\",\n      \"3. Add internal helper normalizeConditionSchema(schema: JsonObject): JsonObject that clones schema, sets type to 'object' when properties is an object, adds every key of properties whose value is an object without a 'not' property into required, and recurses on nested properties, allOf, anyOf, and oneOf.\",\n      \"4. Add internal helper matchesSchemaCondition(conditionSchema: JsonObject, formData: JsonObject): boolean that validates stripUndefined(formData) against normalizeConditionSchema(conditionSchema) using new JSONSchema(normalized).isValid(cleanData).\",\n      \"5. Add internal helper isDependencyTruthy(value: JsonValue | undefined): boolean that returns true when value is not undefined, null, false, '', or an empty array.\",\n      \"6. Add internal helper getConditionKeys(conditionSchema: JsonObject): string[] that collects property names referenced in conditionSchema.properties, conditionSchema.required, and recursively in conditionSchema.allOf, conditionSchema.anyOf, conditionSchema.oneOf, and conditionSchema.not.\",\n      \"7. Export collectAllSchemaKeys(steps: Pick<ParsedTemplateSchema, 'mergedSchema'>[]): Set<string> that traverses each step's mergedSchema (properties, dependencies, then, else, allOf, oneOf, anyOf) and returns the set of al