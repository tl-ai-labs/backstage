  {
    "id": "U01",
    "path": "packages/repo-tools/src/commands/peer-deps/peer-deps.ts",
    "action": "edit",
    "phase": "codegen",
    "behaviour": "The peer-deps check expects one React 18 only peer map for every package and drops the React 18 only exception list.",
    "rules": [
      "The single `peerDependencies` const is `{ '@types/react': '^18.0.0', react: '^18.0.0', 'react-dom': '^18.0.0', 'react-router-dom': '^6.30.2' }`; no other const replaces it.",
      "`peerDependenciesReact18Only`, `react18OnlyPackages`, its comment and `getExpectedPeerDependencies` are gone; every former `expectedPeerDeps[...]`/`expected[...]` lookup reads `peerDependencies[dep as keyof typeof peerDependencies]` (or `groupDep`).",
      "All checks, messages, fix behaviour and the exit code stay as they are."
    ],
    "sites": [
      {
        "id": "S1",
        "at": "replace",
        "from": 35,
        "to": 50,
        "first_line": "const peerDependencies = {",
        "last_line": "const react18OnlyPackages = new Set(['@backstage/ui']);",
        "rule": "One `peerDependencies` const with the three React entries at '^18.0.0' and 'react-router-dom': '^6.30.2'."
      },
      {
        "id": "S2",
        "at": "delete",
        "from": 92,
        "to": 97,
        "first_line": "const getExpectedPeerDependencies = (packageJson: ExtendedPackageJSON) => {",
        "last_line": "};",
        "rule": "Remove the function."
      },
      {
        "id": "S3",
        "at": "replace",
        "from": 99,
        "to": 108,
        "first_line": "const matchesPeerDependency = (",
        "last_line": "};",
        "rule": "Keep the signature `(dep: string, packageJson: ExtendedPackageJSON)`; compare `packageJson.peerDependencies[dep]` with `peerDependencies[dep as keyof typeof peerDependencies]`."
      },
      {
        "id": "S4",
        "at": "delete",
        "from": 145,
        "to": 145,
        "first_line": "const expectedPeerDeps = getExpectedPeerDependencies(packageJson);",
        "rule": "Remove the line."
      },
      {
        "id": "S5",
        "at": "replace",
        "from": 217,
        "to": 218,
        "first_line": "packageJson.peerDependencies[groupDep] =",
        "last_line": "expectedPeerDeps[groupDep as keyof typeof expectedPeerDeps];",
        "rule": "Assign `peerDependencies[groupDep as keyof typeof peerDependencies]`."
      },
      {
        "id": "S6",
        "at": "replace",
        "from": 244,
        "to": 245,
        "first_line": "packageJson.peerDependencies[dep] =",
        "last_line": "expectedPeerDeps[dep as keyof typeof expectedPeerDeps];",
        "rule": "Assign `peerDependencies[dep as keyof typeof peerDependencies]`."
      },
      {
        "id": "S7",
        "at": "replace",
        "from": 254,
        "to": 255,
        "first_line": "packageJson.peerDependencies[dep] =",
        "last_line": "expectedPeerDeps[dep as keyof typeof expectedPeerDeps];",
        "rule": "Assign `peerDependencies[dep as keyof typeof peerDependencies]`."
      }
    ],
    "depends_on": [],
    "covers": ["FR-2", "FR-3", "AC-1", "NFR-1", "NFR-2"],
    "checks": ["eslint", "prettier"]
  },
